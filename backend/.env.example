# Sunucu
PORT=4000
NODE_ENV=development

# Frontend adresi (CORS ve sayfa yenileme için)
FRONTEND_URL=http://localhost:3000

# Neon PostgreSQL bağlantı adresi
DATABASE_URL=postgresql://kullanici:sifre@host/veritabani?sslmode=require

# Oturum cookie'sini imzalamak için uzun, rastgele bir değer
SESSION_SECRET=degistir-beni-en-az-32-karakter

# Frontend'deki REVALIDATE_SECRET ile aynı olmalı
REVALIDATE_SECRET=degistir-beni

# Zamanlanmış yazılar için /api/internal/publish-due ucunu çağıran zamanlayıcının anahtarı
CRON_SECRET=degistir-beni

# Yalnızca prisma/seed.ts için (B2, Y1). Yayında seed'den sonra silin.
SEED_ADMIN_1_EMAIL=
SEED_ADMIN_1_PASSWORD=
SEED_ADMIN_2_EMAIL=
SEED_ADMIN_2_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
