# Backend API adresi. Yalnızca sunucuda kullanılır: sayfa üretimi ve /api yönlendirmesi (F10).
# NEXT_PUBLIC_ ön eki bilerek yok; tarayıcı backend'e doğrudan değil, sitenin kendi /api adresi üzerinden gider.
API_URL=http://localhost:4000/api

# Sitenin genel adresi (SEO, sitemap ve sosyal önizlemeler için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend'in sayfa yenileme isteğini doğrulamak için paylaşılan gizli anahtar (backend ile aynı olmalı)
REVALIDATE_SECRET=degistir-beni

# Faz 2A'da backend hazır değilken sahte veri kullanmak için: true
USE_MOCK_DATA=true
